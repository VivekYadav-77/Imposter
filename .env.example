APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/imposter_game
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_READY_TIMEOUT_MS=1500
SERVICE_VERSION=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSP_IMAGE_SOURCES=http://127.0.0.1:3000,http://localhost:3000
MAX_JSON_BODY_BYTES=65536
EXPOSE_API_DOCS=true
SHUTDOWN_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_REQUESTS=180
TRUST_PROXY=false
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
ADMIN_SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5
PARTICIPANT_SESSION_TOKEN_PEPPER=replace-with-a-different-32-character-random-value
PARTICIPANT_SESSION_TTL_SECONDS=7200
USER_SESSION_TOKEN_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
USER_SESSION_TTL_SECONDS=2592000
ROOM_LOBBY_TTL_SECONDS=7200
ROOM_CODE_COOLDOWN_SECONDS=86400
HOST_DISCONNECT_GRACE_SECONDS=30
ROOM_MAINTENANCE_INTERVAL_MS=10000
EVIDENCE_LOCAL_DIRECTORY=.data/evidence
EVIDENCE_UPLOAD_TTL_SECONDS=300
EVIDENCE_VIEW_TTL_SECONDS=60
EVIDENCE_MAX_BYTES=5242880
EVIDENCE_GAME_MAX_BYTES=251658240
EVIDENCE_MAX_PIXELS=20000000
EVIDENCE_RETENTION_SECONDS=86400
EVIDENCE_ORPHAN_TTL_SECONDS=3600
EVIDENCE_WORKER_INTERVAL_MS=5000
EVIDENCE_UPLOAD_MAX_CONCURRENT=8
EVIDENCE_UPLOAD_MAX_QUEUED=64
EVIDENCE_UPLOAD_QUEUE_TIMEOUT_MS=15000
EVIDENCE_PROCESSING_CONCURRENCY=2
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_DISCONNECT_GRACE_MS=5000
