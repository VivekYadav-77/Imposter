{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.imposter-game.invalid/realtime-v1.schema.json",
  "title": "Imposter Game realtime schema v1",
  "oneOf": [
    { "$ref": "#/$defs/roomSnapshot" },
    { "$ref": "#/$defs/gameSnapshot" },
    { "$ref": "#/$defs/presenceChanged" },
    { "$ref": "#/$defs/sessionRevoked" },
    { "$ref": "#/$defs/resyncRequired" },
    { "$ref": "#/$defs/serverReady" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "type", "occurredAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "type": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "roomId": { "type": "string", "format": "uuid" }
      }
    },
    "roomSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "roomId", "data"],
          "properties": { "type": { "const": "room.snapshot" }, "data": { "type": "object" } }
        }
      ]
    },
    "gameSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "roomId", "gameId", "stateVersion", "data"],
          "properties": {
            "type": { "const": "game.snapshot" },
            "gameId": { "type": "string", "format": "uuid" },
            "stateVersion": { "type": "integer", "minimum": 1 },
            "data": { "type": "object" }
          }
        }
      ]
    },
    "presenceChanged": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "roomId", "data"],
          "properties": {
            "type": { "const": "presence.changed" },
            "data": {
              "type": "object",
              "required": ["participantId", "presence"],
              "properties": {
                "participantId": { "type": "string", "format": "uuid" },
                "presence": { "enum": ["connected", "away"] }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "sessionRevoked": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": { "const": "session.revoked" },
            "data": {
              "type": "object",
              "required": ["reason"],
              "properties": { "reason": { "type": "string" } },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "resyncRequired": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "roomId", "data"],
          "properties": {
            "type": { "const": "server.resync_required" },
            "data": {
              "type": "object",
              "required": ["reason"],
              "properties": { "reason": { "type": "string" } },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "serverReady": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "server.ready" } }
        }
      ]
    }
  }
}
